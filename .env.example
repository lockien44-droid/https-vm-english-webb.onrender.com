# Copy to .env for local dev (never commit .env)
# On Render: Dashboard → Environment → Add Variable

# ChatGPT / OpenAI (ưu tiên nếu có cả hai)
OPENAI_API_KEYS=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEYS=your_gemini_key_here
# Models thử lần lượt nếu model đầu quá tải (503)
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash-8b,gemini-flash-latest

# auto | openai | gemini
AI_PROVIDER=gemini
